# Ignore VXRecon local workspaces and build artifacts.
# NOTE: these are anchored to the repository root (/...) so they do NOT
# accidentally ignore source packages such as vxrecon/cases/.
/.vxrecon/
/reports/
/cases/
/*.db
/*.db-wal
/*.db-shm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
